<UserControl x:Class="QuackOSD.ColorPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="200"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Rectangle x:Name="ColorSaturationValuePlane">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="White" Offset="0.0" />
                        <GradientStop Color="Red" Offset="1.0" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Transparent" Offset="0.0" />
                        <GradientStop Color="Black" Offset="1.0" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Canvas x:Name="ColorCanvas" Background="Transparent"
                    PreviewMouseLeftButtonDown="ColorCanvas_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ColorCanvas_MouseMove"
                    PreviewMouseLeftButtonUp="ColorCanvas_PreviewMouseLeftButtonUp"
                    Cursor="Cross">
                <Ellipse x:Name="ColorSelector"
                         Width="10" Height="10"
                         Stroke="White" StrokeThickness="2"
                         IsHitTestVisible="False"
                         Fill="Transparent"/>
            </Canvas>
        </Grid>

        <Slider x:Name="HueSlider" Grid.Row="1"
                Minimum="0" Maximum="360" Value="0"
                Margin="0,10,0,0"
                ValueChanged="HueSlider_ValueChanged"
                IsMoveToPointEnabled="True">
            <Slider.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="Red" Offset="0.0" />
                    <GradientStop Color="Yellow" Offset="0.166" />
                    <GradientStop Color="Green" Offset="0.333" />
                    <GradientStop Color="Cyan" Offset="0.5" />
                    <GradientStop Color="Blue" Offset="0.666" />
                    <GradientStop Color="Magenta" Offset="0.833" />
                    <GradientStop Color="Red" Offset="1.0" />
                </LinearGradientBrush>
            </Slider.Background>
        </Slider>

        <Slider x:Name="AlphaSlider" Grid.Row="2"
                Minimum="0" Maximum="255" Value="255"
                Margin="0,10,0,0"
                ValueChanged="AlphaSlider_ValueChanged"
                IsMoveToPointEnabled="True">
        </Slider>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="PreviewColorBorder"
                    Grid.Column="0"
                    Height="40"
                    Background="Red"
                    BorderBrush="Black" BorderThickness="1"/>

            <TextBox x:Name="HexTextBox" 
                     Grid.Column="1"
                     Margin="10,0,0,0" 
                     Height="40"
                     VerticalContentAlignment="Center"
                     TextChanged="HexTextBox_TextChanged"/>
        </Grid>

    </Grid>
</UserControl>